<Window x:Class="Spire.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:Spire.Core;assembly=Spire.Core" xmlns:local="clr-namespace:Spire.Windows" Title="Spire — native Windows development" Width="1280" Height="850" MinWidth="760" MinHeight="540" Background="#101010" Foreground="White" Closing="OnClosing" PreviewKeyDown="KeyboardActions">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="#242424"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#444444"/><Setter Property="Focusable" Value="False"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#191919"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#444444"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="White"/><Setter Property="IsExpanded" Value="True"/></Style>
  <HierarchicalDataTemplate DataType="{x:Type core:NavigationNode}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Label}" ToolTip="{Binding Path}" Margin="3,5"/></HierarchicalDataTemplate>
 </Window.Resources>
 <DockPanel Margin="12">
  <Border DockPanel.Dock="Bottom" BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="4,8"><TextBlock x:Name="Status" Text="Opening native workspace…" TextWrapping="Wrap"/></Border>
  <Grid x:Name="Shell">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,12">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Actions" Click="QuickActions"/><Button Content="Quick actions" Click="QuickActionsManager"/><Button Content="Styles" Click="StylesHandler"/><Button Content="Settings" Click="Settings"/><Button Content="Adopt preview" Click="AdoptPreview"/><Button Content="Connect" Click="Connect"/><Button Content="Sync" Click="Sync"/><Button Content="Conflicts" Click="Conflicts"/></StackPanel>
    <StackPanel Orientation="Horizontal"><Button Content="☰" ToolTip="Toggle sidebar" Click="ToggleSidebar"/><Button Content="SPIRE" FontSize="22" Click="Home"/><TextBlock Text="Native / local-first" Foreground="#999999" VerticalAlignment="Center" Margin="12,0"/></StackPanel>
   </DockPanel>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="280"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <DockPanel x:Name="Sidebar" Background="#151515">
     <WrapPanel DockPanel.Dock="Top"><Button Content="Files" Click="FilesTab"/><Button Content="Tags" Click="TagsTab"/><Button Content="Templates" Click="TemplatesTab"/><Button Content="Sources" Click="SourcesTab"/></WrapPanel>
     <TextBox x:Name="Search" DockPanel.Dock="Top" ToolTip="Search files and content" TextChanged="SearchChanged" Margin="6"/>
     <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8"><Button x:Name="AddAction" Content="Add file" Click="NewFile"/><Button x:Name="TrashToggle" Content="Trash" Click="ToggleTrash"/></StackPanel>
     <WrapPanel DockPanel.Dock="Top" HorizontalAlignment="Center"><Button x:Name="CreateFolderAction" Content="Add folder" Click="CreateFolder"/><Button x:Name="MoveFolderAction" Content="Move folder" Click="MoveFolder"/><Button x:Name="DeleteFolderAction" Content="Delete folder" Click="DeleteFolder"/></WrapPanel>
     <TreeView x:Name="Files" Background="#151515" BorderThickness="0" SelectedItemChanged="SelectFile"/>
    </DockPanel>
    <DockPanel Grid.Column="2">
     <StackPanel DockPanel.Dock="Top">
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Save" Click="SaveFile"/><Button x:Name="TrashAction" Content="Trash file" Click="TrashFile"/><Button Content="History" Click="History"/></StackPanel><TextBox x:Name="FilePath" ToolTip="Folder/file.md" VerticalAlignment="Center"/></DockPanel>
      <WrapPanel Margin="0,8"><Button Content="Text style" Click="TextStyle"/><Button Content="Headings" Click="Headings"/><Button Content="Blocks" Click="Blocks"/><Button Content="Highlight" Click="Highlight"/><Button Content="Table" Click="Table"/><Button Content="Link" Click="Link"/><Button Content="Date &amp; time" Click="DateTimeGallery"/><Button Content="Citation" Click="Citation"/><Button Content="Insert template" Click="InsertTemplate"/><Button Content="Save as template" Click="SaveAsTemplate"/><Button Content="Map" Click="Map"/><Button Content="Media" Click="Media"/><Button Content="Dictionary" Click="Dictionary"/><Button Content="Properties" Click="Properties"/><Button Content="Star" Click="Star"/></WrapPanel>
      <StackPanel Orientation="Horizontal"><Button x:Name="ViewToggle" Content="Writing / Source" Click="ToggleWriting"/><TextBlock x:Name="EditorLabel" Text="Native writing • protected blocks retain their original source" Foreground="#999999" VerticalAlignment="Center" Margin="4,0,0,8"/></StackPanel>
     </StackPanel>
     <Grid><TextBox x:Name="Editor" Visibility="Collapsed" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="17" Padding="24"/><local:NativeWritingView x:Name="Writing"/></Grid>
    </DockPanel>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
