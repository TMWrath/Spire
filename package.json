{
  "name": "spire",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "desktop-dist/main.cjs",
  "description": "Spire local-folder and server desktop workspace",
  "author": "T.M. Wrath",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "prepare:voice": "node scripts/prepare-voice-assets.mjs",
    "build": "node scripts/prepare-voice-assets.mjs --verify-only && tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:browser": "playwright test",
    "backup": "tsx server/backup.ts",
    "desktop:build": "npm run build && node desktop/build.mjs",
    "desktop:start": "electron .",
    "desktop:package": "npm run desktop:build && electron-builder --win --x64",
    "test:desktop": "node tests/desktop-electron.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "cactus-needle": "0.3.0",
    "cookie-parser": "^1.4.7",
    "diff": "^9.0.0",
    "dompurify": "^3.2.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fflate": "^0.8.2",
    "helmet": "^8.1.0",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.3",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "mammoth": "1.13.0",
    "marked": "^16.3.0",
    "mermaid": "^12.1.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.18.1",
    "tsx": "^4.20.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
